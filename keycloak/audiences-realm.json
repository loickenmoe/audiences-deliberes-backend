{
  "realm": "audiences-realm",
  "enabled": true,
  "displayName": "Audiences et Délibérés",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 3600,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "ROLE_JURISTE",
        "description": "Juriste - gestion des dossiers",
        "composite": true,
        "composites": { "realm": ["ROLE_SAISIE"] }
      },
      {
        "name": "ROLE_DJ",
        "description": "Directeur Juridique - tous les droits d'un juriste, plus les siens (Q-81)",
        "composite": true,
        "composites": { "realm": ["ROLE_SAISIE", "ROLE_JURISTE"] }
      },
      {
        "name": "ROLE_DJA",
        "description": "Directeur Juridique Adjoint - tous les droits d'un juriste, plus les siens (Q-81)",
        "composite": true,
        "composites": { "realm": ["ROLE_SAISIE", "ROLE_JURISTE"] }
      },
      {
        "name": "ROLE_ASSISTANTE",
        "description": "Assistante juridique",
        "composite": true,
        "composites": { "realm": ["ROLE_SAISIE"] }
      },
      {
        "name": "ROLE_SH",
        "description": "Supérieur Hiérarchique (Chef de département)",
        "composite": true,
        "composites": { "realm": ["ROLE_SAISIE"] }
      },
      { "name": "ROLE_AVOCAT",       "description": "Avocat partenaire externe" },
      { "name": "ROLE_CONSULTATION", "description": "Lecture seule - tous profils habilités" },
      { "name": "ROLE_SAISIE",       "description": "Saisie - implicite pour Juriste, DJ, DJA, Assistante, SH (rôle composite, cf. DECISIONS_AND_OPEN_QUESTIONS.md Q-08)" }
    ]
  },
  "clients": [
    {
      "clientId": "audiences-api",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "secret": "audiences-api-secret",
      "redirectUris": ["http://localhost:3000/*", "http://localhost:8080/*"],
      "webOrigins": ["http://localhost:3000", "http://localhost:8080"],
      "protocolMappers": [
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "users": [
    {
