# =============================================================================
# For read environment variable, add this line in top to application.properties
# =============================================================================
spring.config.import=optional:file:.env[.properties]

# =============================================================================
# DATABASE - local PostgreSQL (Docker) - application database "audiences_app"
# =============================================================================
# The "postgres" container of docker-compose.yml hosts both the Keycloak database
# (POSTGRES_DB below) and the application database "audiences_app" (created automatically
# by docker/postgres/init-app-db.sql). From the host (mvn spring-boot:run) target localhost;
# from a container on the same Docker network, target "postgres".
# Host port 5433 by default (instead of 5432) to avoid clashing with a native
# PostgreSQL install (e.g. Windows service "postgresql-x64-17").
DATABASE_URL=jdbc:postgresql://localhost:5433/audiences_app
DATABASE_USERNAME=audiences_user
DATABASE_PASSWORD=changeme-local-only

# =============================================================================
# DATABASE - local Docker (used by Keycloak, and by init-app-db.sql for audiences_app)
# =============================================================================
POSTGRES_DB=audiences_db
POSTGRES_USER=audiences_user
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_PORT=5433

# =============================================================================
# KEYCLOAK
# =============================================================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme-local-only
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/audiences-realm
KEYCLOAK_JWK_SET_URI=http://localhost:8081/realms/audiences-realm/protocol/openid-connect/certs

# =============================================================================
# BACKEND
# =============================================================================
BACKEND_PORT=8080
JPA_ACTION=update
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# =============================================================================
# MINIO - Local Docker
# =============================================================================
MINIO_PROJECT_NAME=audiences-app
MINIO_API_URL=http://localhost:9000
MINIO_USERNAME=minio_username
MINIO_PASSWORD=changeme-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001


# =============================================================================
# NOTIFICATION ENGINE (optional - disabled by default)
# =============================================================================
# Service account provided by the Notification Engine administrator. While
# NOTIFICATION_ENGINE_ACTIF=false, no notification leaves the application.
# NOTIFICATION_ENGINE_ACTIF=false
# NOTIFICATION_ENGINE_CODE_SERVICE=
# NOTIFICATION_ENGINE_JWT_SECRET=
# Application URL in notification links (default: http://localhost:3000).
# NOTIFICATION_LIEN_APPLICATION=http://localhost:3000
# Test recipients: outside production every message is redirected to them (nothing is sent
# to a real lawyer or user). Required as soon as the Notification Engine is enabled.
# NOTIFICATION_REDIRECTION_ACTIVE=true
# NOTIFICATION_REDIRECTION_COURRIEL_INTERNE=
# NOTIFICATION_REDIRECTION_COURRIEL_PERSONNEL=
# NOTIFICATION_REDIRECTION_TELEPHONE=
# Transport to the Notification Engine: DAPR (sidecar, documented path) or KAFKA (direct fallback).
# NOTIFICATION_TRANSPORT=DAPR
# Kafka broker of the target environment (DEV is the only one reachable from workstations):
# KAFKA_BOOTSTRAP_SERVERS=
