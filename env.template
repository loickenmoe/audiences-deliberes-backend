# =============================================================================
# For read environment variable, add this line in top to application.properties
# =============================================================================
spring.config.import=optional:file:.env[.properties]

# =============================================================================
# DATABASE - PostgreSQL local (Docker) — base applicative "audiences_app"
# =============================================================================
# Le conteneur "postgres" du docker-compose.yml héberge à la fois la base de Keycloak
# (POSTGRES_DB ci-dessous) et la base applicative "audiences_app" (créée automatiquement
# par docker/postgres/init-app-db.sql). Depuis l'hôte (mvn spring-boot:run), on cible
# localhost ; depuis un conteneur du même réseau docker, on ciblerait "postgres".
# Port hôte 5433 par défaut (au lieu de 5432) pour éviter tout conflit avec une éventuelle
# installation PostgreSQL native (ex : service Windows "postgresql-x64-17").
DATABASE_URL=jdbc:postgresql://localhost:5433/audiences_app
DATABASE_USERNAME=audiences_user
DATABASE_PASSWORD=changeme-local-only

# =============================================================================
# DATABASE - Docker local (utilisé par Keycloak, et par init-app-db.sql pour audiences_app)
# =============================================================================
POSTGRES_DB=audiences_db
POSTGRES_USER=audiences_user
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_PORT=5433

# =============================================================================
# KEYCLOAK
# =============================================================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme-local-only
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/audiences-realm
KEYCLOAK_JWK_SET_URI=http://localhost:8081/realms/audiences-realm/protocol/openid-connect/certs

# =============================================================================
# BACKEND
# =============================================================================
BACKEND_PORT=8080
JPA_ACTION=update
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# =============================================================================
# MINIO - Local Docker
# =============================================================================
MINIO_PROJECT_NAME=audiences-app
MINIO_API_URL=http://localhost:9000
MINIO_USERNAME=minio_username
MINIO_PASSWORD=changeme-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# =============================================================================
# JAVAMAIL (optionnel)
# =============================================================================
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_PROTOCOL=smtp

# =============================================================================
# NOTIFICATION ENGINE (optionnel — désactivé par défaut)
# =============================================================================
# Compte de service fourni par l'administrateur du Notification Engine. Tant que
# NOTIFICATION_ENGINE_ACTIF=false, aucune notification ne quitte l'application.
# NOTIFICATION_ENGINE_ACTIF=false
# NOTIFICATION_ENGINE_CODE_SERVICE=
# NOTIFICATION_ENGINE_JWT_SECRET=
# Adresse de l'application dans les liens des notifications (défaut : http://localhost:3000).
# NOTIFICATION_LIEN_APPLICATION=http://localhost:3000
