{
  "realm": "audiences-realm",
  "enabled": true,
  "displayName": "Audiences et Délibérés",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 3600,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      { "name": "ROLE_JURISTE",      "description": "Juriste - gestion des dossiers" },
      { "name": "ROLE_DJ",           "description": "Directeur Juridique" },
      { "name": "ROLE_DJA",          "description": "Directeur Juridique Adjoint" },
      { "name": "ROLE_ASSISTANTE",   "description": "Assistante juridique" },
      { "name": "ROLE_SH",           "description": "Supérieur Hiérarchique (Chef de département)" },
      { "name": "ROLE_AVOCAT",       "description": "Avocat partenaire externe" },
      { "name": "ROLE_GFC",          "description": "Gestion Financière et Comptable" },
      { "name": "ROLE_CONSULTATION", "description": "Lecture seule - tous profils habilités" }
    ]
  },
  "clients": [
    {
      "clientId": "audiences-api",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "secret": "audiences-api-secret",
      "redirectUris": ["http://localhost:3000/*", "http://localhost:8888/*"],
      "webOrigins": ["http://localhost:3000", "http://localhost:8888"],
      "protocolMappers": [
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "users": [
